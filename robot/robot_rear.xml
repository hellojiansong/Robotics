<!-- Placeholder to just get rl working mostly made with AI!!!!! -->

<mujoco model="rover_scene">

  <compiler angle="radian" autolimits="true"/>

  <!-- timestep dropped to 0.002 s; implicitfast handles stiff contacts better -->
  <option timestep="0.002"
          gravity="0 0 -9.81"
          iterations="50"
          solver="Newton"
          integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <map znear="0.01" zfar="200"/>
  </visual>

  <asset>
    <texture name="checker"
             type="2d"
             builtin="checker"
             width="512" height="512"
             rgb1="0.68 0.62 0.50"
             rgb2="0.82 0.76 0.62"/>
    <material name="ground_mat"
              texture="checker"
              texrepeat="20 10"
              reflectance="0.06"/>

    <material name="chassis_mat" rgba="0.12 0.32 0.72 1"  reflectance="0.15"/>
    <material name="wheel_mat"   rgba="0.07 0.07 0.08 1"  reflectance="0.05"/>
    <material name="rim_mat"     rgba="0.62 0.63 0.68 1"  reflectance="0.35"/>
    <material name="ballast_mat" rgba="0.18 0.18 0.20 1"  reflectance="0.05"/>
    <material name="axle_mat"    rgba="0.55 0.55 0.60 1"  reflectance="0.25"/>

    <material name="goal_outer_mat" rgba="0.05 0.90 0.15 0.55"/>
    <material name="goal_inner_mat" rgba="0.05 1.00 0.05 0.95"/>
  </asset>

  <worldbody>

    <light name="key_sun"
           directional="true"
           pos="6 -4 10"
           dir="-0.45 0.28 -1.0"
           diffuse="0.88 0.82 0.74"
           specular="0.30 0.28 0.24"
           castshadow="true"/>

    <light name="fill"
           directional="true"
           pos="-5 4 6"
           dir="0.42 -0.32 -0.85"
           diffuse="0.22 0.25 0.36"
           specular="0.0 0.0 0.0"
           castshadow="false"/>

    <light name="rim"
           directional="true"
           pos="0 6 5"
           dir="0.0 -0.75 -0.65"
           diffuse="0.14 0.16 0.20"
           specular="0.06 0.06 0.08"
           castshadow="false"/>

    <geom name="ground"
          type="plane"
          size="120 60 0.1"
          material="ground_mat"
          condim="3"
          friction="1.0 0.005 0.0001"/>

    <body name="chassis" pos="0 0 0.20">
      <freejoint name="root"/>

      <geom name="chassis_body"
            type="box"
            size="0.38 0.21 0.065"
            pos="0 0 0.025"
            material="chassis_mat"
            mass="3.5"/>

      <geom name="ballast"
            type="box"
            size="0.27 0.15 0.032"
            pos="-0.15 0 -0.052"
            material="ballast_mat"
            mass="7.0"/>

      <geom name="axle_f"  type="cylinder" size="0.022 0.235"
            pos=" 0.22 0 -0.08" euler="1.5708 0 0"
            material="axle_mat" mass="0.05"
            contype="0" conaffinity="0"/>
      <geom name="axle_r"  type="cylinder" size="0.022 0.235"
            pos="-0.22 0 -0.08" euler="1.5708 0 0"
            material="axle_mat" mass="0.05"
            contype="0" conaffinity="0"/>

      <site name="imu" pos="0 0 0" size="0.01"/>

      <camera name="robot_pov"
              pos="0.15 0 0.25"
              xyaxes="0 -1 0  0.18 0 1"
              fovy="80"/>

      <body name="wheel_fl" pos=" 0.22  0.245 -0.08">
        <joint name="spin_fl" type="hinge" axis="0 1 0" damping="2.0"/>
        <geom name="tyre_fl" type="cylinder" size="0.12 0.055"
              euler="1.5708 0 0" material="wheel_mat" mass="0.65"
              friction="1.3 0.005 0.0001"/>
        <geom name="rim_fl"  type="cylinder" size="0.068 0.058"
              euler="1.5708 0 0" material="rim_mat"   mass="0.0"
              contype="0" conaffinity="0"/>
      </body>

      <body name="wheel_fr" pos=" 0.22 -0.245 -0.08">
        <joint name="spin_fr" type="hinge" axis="0 1 0" damping="2.0"/>
        <geom name="tyre_fr" type="cylinder" size="0.12 0.055"
              euler="1.5708 0 0" material="wheel_mat" mass="0.65"
              friction="1.3 0.005 0.0001"/>
        <geom name="rim_fr"  type="cylinder" size="0.068 0.058"
              euler="1.5708 0 0" material="rim_mat"   mass="0.0"
              contype="0" conaffinity="0"/>
      </body>

      <body name="wheel_rl" pos="-0.22  0.245 -0.08">
        <joint name="spin_rl" type="hinge" axis="0 1 0" damping="2.0"/>
        <geom name="tyre_rl" type="cylinder" size="0.12 0.055"
              euler="1.5708 0 0" material="wheel_mat" mass="0.65"
              friction="1.3 0.005 0.0001"/>
        <geom name="rim_rl"  type="cylinder" size="0.068 0.058"
              euler="1.5708 0 0" material="rim_mat"   mass="0.0"
              contype="0" conaffinity="0"/>
      </body>

      <body name="wheel_rr" pos="-0.22 -0.245 -0.08">
        <joint name="spin_rr" type="hinge" axis="0 1 0" damping="2.0"/>
        <geom name="tyre_rr" type="cylinder" size="0.12 0.055"
              euler="1.5708 0 0" material="wheel_mat" mass="0.65"
              friction="1.3 0.005 0.0001"/>
        <geom name="rim_rr"  type="cylinder" size="0.068 0.058"
              euler="1.5708 0 0" material="rim_mat"   mass="0.0"
              contype="0" conaffinity="0"/>
      </body>

    </body>
  </worldbody>

  <!--
    Velocity actuators: ctrl = target wheel speed (rad/s)
    kv=6, range=±20 → up to 120 Nm per wheel at t=0  (stable with implicitfast)
    Top speed: 20 rad/s × 0.12 m radius ≈ 2.4 m/s
    env_wrapper maps agent actions [-1, 1] → [-20, 20] rad/s via MAX_WHEEL_VEL.
  -->
  <actuator>
    <velocity name="motor_fl" joint="spin_fl" kv="6" ctrlrange="-20 20" ctrllimited="true"/>
    <velocity name="motor_fr" joint="spin_fr" kv="6" ctrlrange="-20 20" ctrllimited="true"/>
    <velocity name="motor_rl" joint="spin_rl" kv="6" ctrlrange="-20 20" ctrllimited="true"/>
    <velocity name="motor_rr" joint="spin_rr" kv="6" ctrlrange="-20 20" ctrllimited="true"/>
  </actuator>

  <!--        SENSORS      -->
  <sensor>
    <framepos     name="chassis_pos"     objtype="site" objname="imu"/>
    <framequat    name="chassis_quat"    objtype="site" objname="imu"/>
    <framelinvel  name="chassis_linvel"  objtype="site" objname="imu"/>
    <frameangvel  name="chassis_angvel"  objtype="site" objname="imu"/>
    <gyro         name="gyro"            site="imu"/>
    <accelerometer name="accel"          site="imu"/>
  </sensor>

</mujoco>